var mincostTickets = function (days, costs) {
    const n = days.length;
    const memo = new Map();

    function dfs(i) {
        // Base case: no more travel days
        if (i >= n) return 0;

        // Memo check
        if (memo.has(i)) return memo.get(i);

        // Option 1: 1-day pass
        let j = i;
        while (j < n && days[j] < days[i] + 1) j++;
        const cost1 = costs[0] + dfs(j);

        // Option 2: 7-day pass
        j = i;
        while (j < n && days[j] < days[i] + 7) j++;
        const cost7 = costs[1] + dfs(j);

        // Option 3: 30-day pass
        j = i;
        while (j < n && days[j] < days[i] + 30) j++;
        const cost30 = costs[2] + dfs(j);

        const res = Math.min(cost1, cost7, cost30);

        memo.set(i, res);
        return res;
    }

    return dfs(0);
};
